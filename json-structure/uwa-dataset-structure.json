    },
    "personAssociations": {
      "type": "array",
      "items": {
        "type": "object",
        "name": "WSClassifiedDataSetPersonAssociation"
      }
    },
    "managingOrganisationalUnit": {
      "type": "object",
      "name": "WSOrganisationRef"
    },
    "publisher": {
      "type": "object",
      "name": "WSPublisherRef"
    },
    "doi": {
      "type": "string"
    },
    "documents": {
      "type": "array",
      "items": {
        "type": "object",
        "name": "WSDataSetDocument"
      }
    },
    "physicalDatas": {
      "type": "array",
      "items": {
        "type": "object",
        "name": "WSDataSetPhysicalData"
      }
    },
    "contactPerson": {
      "type": "object",
