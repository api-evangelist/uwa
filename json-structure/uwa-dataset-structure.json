    "organisationalUnits": {
      "type": "array",
      "items": {
        "type": "object",
        "name": "WSOrganisationRef"
      }
    },
    "externalOrganisations": {
      "type": "array",
      "items": {
        "type": "object",
        "name": "WSExternalOrganisationRef"
      }
    },
    "publicationDate": {
      "type": "object",
      "name": "WSCompoundDate"
    },
    "openAccessPermission": {
      "type": "object",
      "name": "WSClassification"
    },
    "relatedDataSets": {
      "type": "array",
      "items": {
        "type": "object",
