    "keywordGroups": {
      "type": "array",
      "items": {
        "type": "object",
        "name": "WSKeywordGroup"
      }
    },
    "visibility": {
      "type": "object",
      "name": "WSVisibility"
    },
    "confidential": {
      "type": "boolean"
    },
    "info": {
      "type": "object",
      "name": "WSContentInformation"
    },
    "openAccessEmbargoMonths": {
      "type": "int64"
    },
    "openAccessEmbargoDate": {
      "type": "date-time"
    }
  }
}