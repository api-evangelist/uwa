    },
    "externallyManaged": {
      "type": "boolean"
    },
    "uuid": {
      "type": "string"
    },
    "renderings": {
      "type": "array",
      "items": {
        "type": "object",
        "name": "WSHtmlRendering"
      }
    },
    "title": {
      "type": "object",
      "name": "WSLocalizedString"
    },
    "type": {
      "type": "object",
      "name": "WSClassification"
    },
    "descriptions": {
      "type": "array",
      "items": {
        "type": "object",
        "name": "WSClassifiedLocalizedValue"
      }
    },
    "temporalCoveragePeriod": {
      "type": "object",
      "name": "WSCompoundDateRange"
    },
    "dataProductionPeriod": {
      "type": "object",
      "name": "WSCompoundDateRange"
    },
    "classifiedSources": {
      "type": "array",
      "items": {
        "type": "object",
        "name": "WSClassifiedValue"
      }
    },
    "geographicalCoverage": {
      "type": "object",
